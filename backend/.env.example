# --- Server ---
PORT=4000
NODE_ENV=development

# Allowed browser origin(s) for CORS. Comma-separate to allow several,
# e.g. your production domain plus Vercel preview deploys.
CLIENT_URL=http://localhost:5173

# --- Database (Supabase Postgres) ---
# Supabase Dashboard > Project Settings > Database > Connection string.
#
# DATABASE_URL = "Transaction pooler" (port 6543). Used at runtime.
#                You MUST append ?pgbouncer=true
# DIRECT_URL   = "Direct connection" (port 5432). Used for migrations only.
#
# Replace [PASSWORD] with your database password and [REF] with your project ref.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Google Sign-In ---
# Create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# --- Sign in with Apple ---
# https://developer.apple.com/sign-in-with-apple/
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Email (password reset) ---
# Without a key, reset links are printed to the server console instead of being
# emailed — fine for local development, but password reset will not work for
# real users in production until this is set.
# Free tier at https://resend.com (3,000 emails/month).
RESEND_API_KEY=
# Must be a domain you've verified with Resend. The default below only delivers
# to your own Resend account address, so change it before launch.
MAIL_FROM="Flex Track <onboarding@resend.dev>"
PASSWORD_RESET_TTL_MINUTES=60

# --- Premium subscription ---
# Web checkout (Stripe). Apple requires In-App Purchase on iOS instead.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# App Store Connect shared secret, for verifying In-App Purchases
APPLE_IAP_SHARED_SECRET=

# --- AI Workout Coach ---
# If set, Flex Track calls Claude to generate personalized plans.
# Without a key, a built-in rule-based generator is used instead,
# so the feature always works out of the box.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (SQLite by default, works with zero setup) ---
# Swap to a Postgres URL in production, e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/flextrack"
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Google Sign-In ---
# Create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# --- Sign in with Apple ---
# https://developer.apple.com/sign-in-with-apple/
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- AI Workout Coach ---
# If set, Flex Track calls Claude to generate personalized plans.
# Without a key, a robust built-in rule-based generator is used instead,
# so the feature always works out of the box.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Apple Health bridge ---
# Each user gets a personal webhook key (generated at signup) used to
# authenticate POSTs from a HealthKit export shortcut / companion app.
HEALTH_WEBHOOK_BASE_PATH=/api/health/webhook

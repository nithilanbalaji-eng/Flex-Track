{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    // "node16" replaces the legacy "node"/"node10" resolution, which newer
    // TypeScript releases removed. package.json declares "type": "commonjs",
    // so this still emits CommonJS and relative imports need no extensions.
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "experimentalDecorators": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
